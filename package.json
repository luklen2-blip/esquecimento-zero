{
  "name": "esquecimento-zero",
  "version": "1.0.0",
  "description": "Sistema inteligente para controle de vencimentos, prazos, garantias e documentos",
  "main": "server/server.js",
  "type": "module",
  "scripts": {
    "start": "node server/server.js",
    "dev": "node --watch server/server.js",
    "test": "node tests/run_all.js && node tests/test_commercial_model.js && node tests/test_reminders_center.js",
    "test:pg": "node tests/test_postgres_lifecycle.js",
    "test:commercial": "node tests/test_commercial_model.js",
    "test:reminders": "node tests/test_reminders_center.js",
    "seed": "node server/database/seed.js",
    "migrate": "node scripts/migrate_json_to_postgres.js",
    "backup": "node scripts/backup_jsondb.js"
  },
  "dependencies": {
    "express": "^4.22.3",
    "multer": "^2.4.0",
    "pg": "^8.23.1"
  },
  "keywords": [
    "produtividade",
    "garantias",
    "vencimentos",
    "documentos",
    "saas"
  ],
  "author": "Luciano",
  "license": "ISC"
}
